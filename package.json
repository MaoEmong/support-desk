{
  "name": "support-desk",
  "private": true,
  "packageManager": "pnpm@11.25.0",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "worker": "node scripts/worker.mjs",
    "dev:web": "pnpm --filter @support/web dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "vitest run",
    "lint": "eslint .",
    "format": "prettier --write .",
    "db:generate": "pnpm --filter @support/db generate",
    "db:migrate": "pnpm --filter @support/db migrate",
    "db:seed": "pnpm --filter @support/db seed",
    "db:demo-accounts": "pnpm --filter @support/db demo-accounts"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "eslint": "9.39.5",
    "typescript-eslint": "8.72.0",
    "prettier": "3.9.10",
    "typescript": "5.9.3",
    "vitest": "3.2.7",
    "@types/node": "22.20.5",
    "dotenv": "17.4.2"
  }
}
